# ============================================================
# AI 网关环境变量样例
#
# 本地开发：**不需要**本文件。直接使用内置的 dev 配置即可：
#   java -jar target/ai-gateway-*.jar --spring.profiles.active=dev
#
# 生产：cp .env.example .env 填入真实值，再启动：
#   set -a && source .env && set +a
#   java -jar target/ai-gateway-*.jar
# 下面三项缺失或仍为默认值时，应用会在启动阶段直接拒绝运行。
# .env 已被 .gitignore 忽略，**切勿提交到版本库**。
# ============================================================

# 渠道密钥加密主密钥：必须是 32 字节的 Base64（AES-256）
#   openssl rand -base64 32
GW_CRYPTO_MASTER_KEY=

# 虚拟 Key 的哈希盐值：随机长串（至少 16 位）
#   openssl rand -hex 32
GW_API_KEY_SALT=

# Web 控制台登录账号（密码至少 8 位）
GW_ADMIN_USER=admin
GW_ADMIN_PASSWORD=

# 可选：机器令牌（脚本/CI 免登录调用管理接口；留空则只允许账号密码登录）
# GW_ADMIN_TOKEN=

# 可选：数据库连接（若未使用默认的 gw 用户/口令）
# GW_DB_USER=gw
# GW_DB_PASSWORD=

# 可选：中间件地址
# GW_REDIS_HOST=127.0.0.1
# GW_REDIS_PORT=6379

# ============================================================
# 上游模型密钥
#
# 建议**不要**用环境变量注入上游 Key，而是在 Web 控制台的「渠道 → 密钥」里写入
# （会以 AES-256-GCM 加密存储、只写不读、不会出现在进程环境里）。
# ============================================================
# UPSTREAM_OPENAI_KEY=
# UPSTREAM_QWEN_KEY=
# UPSTREAM_DEEPSEEK_KEY=
