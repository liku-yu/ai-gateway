# ============================================================
# docker compose 用环境变量样例
#
#   1) cp .env.docker.example .env
#   2) 按下面注释生成并填入随机值
#   3) docker compose up -d
#
# docker compose 会自动读取与本文件同目录的 .env。
# 任一必填项为空时，compose 会直接报错，不会用默认值启动。
# .env 已被 .gitignore 忽略，切勿提交。
# ============================================================

# ---- 数据库（MariaDB 容器）----
MYSQL_DATABASE=ai_gateway
MYSQL_USER=gw

# 生成：openssl rand -base64 24
MYSQL_PASSWORD=

# 生成：openssl rand -base64 24
MYSQL_ROOT_PASSWORD=

# ---- 网关敏感配置（启动期强制校验）----

# 渠道密钥加密主密钥，必须是 32 字节 Base64
# 生成：openssl rand -base64 32
GW_CRYPTO_MASTER_KEY=

# 虚拟 Key 哈希盐，随机长串（至少 16 位）
# 生成：openssl rand -hex 32
GW_API_KEY_SALT=

# 控制台登录账号（密码至少 8 位）
GW_ADMIN_USER=admin
# 生成：openssl rand -base64 18
GW_ADMIN_PASSWORD=

# 可选：机器令牌（脚本/CI 免登录调用管理接口）
# GW_ADMIN_TOKEN=

# 可选：网关对外端口，默认 8080
# GATEWAY_PORT=8080
